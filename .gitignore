# ── 依赖 ──────────────────────────────────────────────────────────────
node_modules/

# ── 本地 / 生成的部署配置（含真实域名、桶名，绝不入库）────────────────
# wrangler.toml 是模板（只有合法默认值，不含任何人的真实域名）；
# 真实值由 scripts/gen-config.mjs 在部署前注入 → wrangler.deploy.toml。
wrangler.deploy.toml
.dev.vars
.dev.vars.*
.wrangler/

# ── 本地运行痕迹 ──────────────────────────────────────────────────────
.devlog
tmp-*
*.tmp
.DS_Store
Thumbs.db
